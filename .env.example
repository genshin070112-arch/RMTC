# 文件：.env.example
# 作用：本地配置模板（纯数据）
# 可复制为 .env，填写后用 ./run.sh --env-file .env 显式读取；字段由 src/config.cpp 处理。
# RMTC_GATEWAY 是服务地址，RMTC_MODEL 是模型名，RMTC_TOKEN_FILE 是令牌文件路径。
# 本文件的 practice-A 仅为练习令牌；正式令牌请使用 tools/set_token.sh。

# Startup settings; this file is data, not a shell script.
# Export ROS_DOMAIN_ID / ROS_LOCALHOST_ONLY in the launch shell.
RMTC_SEAT=A
RMTC_TEAM_NAME=RMTC-CPP
RMTC_STAGE=2
RMTC_MAX_TICKS=500
RMTC_GATEWAY=http://127.0.0.1:8080/v1/chat/completions
RMTC_MODEL=
# Practice token only. Formal token goes in .secrets/team.token.
RMTC_TEAM_TOKEN=practice-A
RMTC_TOKEN_FILE=
RMTC_DECISION_FILE=config/decision_config.json
RMTC_LOG_DIR=logs
RMTC_LLM_TIMEOUT_MS=4000
RMTC_LLM_BUDGET=48
RMTC_MAX_TOKENS=1600
